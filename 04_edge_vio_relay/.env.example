# OpenVPS - Contoh konfigurasi production. Copy ke ".env" lalu isi nilainya,
# atau export langsung sebagai environment variable / EnvironmentFile systemd.
# JANGAN commit file ".env" asli ke git (sudah ada di .gitignore).

# --- Autentikasi (WAJIB diisi di production) ---
# Generate contoh: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPENVPS_API_KEY=

# --- CORS: domain frontend yang boleh akses server ini (pisahkan koma) ---
OPENVPS_CORS_ORIGINS=https://frontend-kamu.example.com

# --- Peta VPS hasil Modul 02 (COLMAP) + Modul 03 (hloc-lite) ---
OPENVPS_MAP_PATH=

# --- YOLO / Multi Object Detection ---
OPENVPS_YOLO_MODEL=yolov8n.pt
OPENVPS_YOLO_CONF=0.35
OPENVPS_YOLO_IOU=0.45
OPENVPS_YOLO_DEVICE=cpu
OPENVPS_YOLO_IMGSZ=640
OPENVPS_YOLO_MAX_DET=50
OPENVPS_DETECT_EVERY_N=1

# --- Storage ---
OPENVPS_UPLOAD_DIR=
OPENVPS_RECORDINGS_DIR=
OPENVPS_MAX_UPLOAD_MB=15
OPENVPS_MAX_WS_FRAME_MB=8

# --- Rate limiting ---
OPENVPS_RATE_LIMIT_ENABLED=true
OPENVPS_RATE_LIMIT_PER_MIN=120

# --- Logging ---
OPENVPS_LOG_LEVEL=INFO
